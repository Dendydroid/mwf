APP_ENV=dev
APP_PORT=8080

# Database
DB_USER=mwf
DB_PASSWORD="DFHSDIFHAMUg3r3fGfgf8fh93dh39ddn39gf97fg32fh"
DB_NAME=app
DB_PORT=5432
DB_HOST=db
DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# Redis
REDIS_URL=redis://redis:6379

# Logging
RUST_LOG=info
RUST_LOG=debug,sqlx=warn
RUST_LOG="mwf=trace,tower_http=debug"

# vLLM inference server (our knobs use LLM_*, vLLM owns the VLLM_* namespace)
LLM_IMAGE=vllm/vllm-openai:latest
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
LLM_PORT=8000
LLM_MAX_MODEL_LEN=4096
LLM_GPU_MEMORY_UTILIZATION=0.90
LLM_ENABLE_PREFIX_CACHING=true
# Host directory for the HuggingFace weights cache (keep it off the
# Docker data disk so a Docker reset does not wipe the download)
LLM_CACHE_DIR=H:/docker/models
# "all" or a number of GPUs to reserve
LLM_GPU_COUNT=all
# WSL2 / Docker Desktop: 1 enables pinned memory, required by the v2 GPU
# model runner. Ignored on native Linux.
LLM_WSL2_PIN_MEMORY=1

# Optional vLLM tuning (leave empty to use vLLM defaults)
LLM_SERVED_MODEL_NAME=
LLM_TENSOR_PARALLEL_SIZE=
LLM_DTYPE=
LLM_API_KEY=
LLM_EXTRA_ARGS=
HUGGING_FACE_HUB_TOKEN=
LLM_URL=http://vllm:${LLM_PORT}/v1
